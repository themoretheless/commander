[
  {
    "label": "Run Commander",
    "command": "cargo",
    "args": ["run", "--release", "--package", "commander", "--bin", "commander"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Test Commander",
    "command": "cargo",
    "args": ["test", "--workspace"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
