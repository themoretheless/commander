{
  "format": "commander.command-templates",
  "version": 3,
  "templates": [
    {
      "name": "Inspect one media file",
      "raw": "ffprobe -v error -show_format -show_streams {paths}",
      "exts": [
        "mp4",
        "mov",
        "mkv"
      ],
      "require_all": true,
      "limits": {
        "min": 1,
        "max": 1
      }
    }
  ]
}
